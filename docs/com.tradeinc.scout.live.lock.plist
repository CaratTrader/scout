<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Scout LIVE loop, LOCK PROFILE (real money). Proposed 2026-09-10; install it yourself:
      ./live_switch_to_lock.sh
  (copies this file over ~/Library/LaunchAgents/com.tradeinc.scout.live.plist and restarts the job).

  What changes versus the previous live profile:
    * the lag/underdog model is OFF (it lost 5 of 5 live trades at asks 0.25-0.46);
    * the bot trades only the late-window TWAP lock: inside the last 45 s, when the part of the
      60 s settlement average already observed makes the outcome near-certain (|z| >= 3.5), buy the
      favourite at 0.955-0.98. Real-book tick study over 5,643 windows: 133 qualifying windows,
      0 losses (1 loss in 143 at |z| >= 3.3), ~+2.4% per trade after fees
      (docs/STRATEGY_RESEARCH.md section 12);
    * the cycle is crypto-only and runs every ~2 s instead of every ~43 s, so it can act inside
      the last 45 s of a window;
    * stake $2-$5 per trade, up to 3 open positions (BTC/ETH are mutually exclusive), no hard
      floor, only the 3-loss-streak halt.
  KeepAlive is SuccessfulExit=false: a deliberate halt (clean exit) is NOT restarted.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradeinc.scout.live</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>-s</string>
        <string>/Users/roomyhome/Tradeinc/.venv/bin/python</string>
        <string>-X</string>
        <string>utf8</string>
        <string>-u</string>
        <string>-m</string>
        <string>scout</string>
        <string>loop</string>
        <string>--live</string>
        <string>--no-grok</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/roomyhome/Tradeinc</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/roomyhome</string>
        <key>PATH</key>
        <string>/Users/roomyhome/Tradeinc/.venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>PYTHONUTF8</key>
        <string>1</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <!-- fast crypto-only cycle; all three assets and both window lengths (the .env paper
             filter is btc/5m only; the lock pocket held in every asset and window) -->
        <key>CRYPTO_ONLY</key>
        <string>1</string>
        <key>CRYPTO_ASSETS</key>
        <string>btc,eth,sol,xrp,doge,bnb,hype</string>
        <key>CRYPTO_WINDOWS_MIN</key>
        <string>5,15,240</string>
        <key>LOOP_SECONDS</key>
        <string>1</string>
        <!-- the per-cycle tape scan (DipArb / complete-set) blocks for TAPE_SECONDS; the default 12 s
             made the whole cycle ~20 s. 1 s is the minimum the code allows and keeps the cycle ~3 s. -->
        <key>TAPE_SECONDS</key>
        <string>1</string>
        <!-- sub-second watch of windows in their last minute: offers at 0.97-0.99 on a decided
             window are lifted within seconds (first live attempt got "no orders found to match") -->
        <key>LOCK_HUNT_SECONDS</key>
        <string>8</string>
        <!-- when the offer is gone before our order lands (most attempts), rest a post-only bid at the
             price ceiling instead of giving up: fee 0, cancelled by the venue at window close -->
        <key>LOCK_REST_AT_CAP</key>
        <string>1</string>
        <key>CRYPTO_EVENT_CACHE_SECONDS</key>
        <string>20</string>
        <key>QUIET_CYCLES</key>
        <string>15</string>
        <!-- strategy: TWAP lock only -->
        <key>CRYPTO_LAG_MODEL</key>
        <string>off</string>
        <key>LESSONS</key>
        <string>0</string>
        <!-- 2026-09-12 review (docs section 13): every recorded loss sat at 0.99 or in the 45-55 s
             extension; fills under 0.985 are 183/0 at +2.45%/$. Back to the tight cut, and 4 s
             later into the window (3-8 s: 0 losses, 97% capture at 1 s in replay). -->
        <key>TWAP_LOCK_MIN_SECONDS</key>
        <string>4</string>
        <key>TWAP_LOCK_MAX_SECONDS</key>
        <string>45</string>
        <key>TWAP_LOCK_ASK_FLOOR</key>
        <string>0.955</string>
        <key>TWAP_LOCK_ASK_CAP</key>
        <string>0.98</string>
        <key>TWAP_LOCK_MIN_Z</key>
        <string>3.5</string>
        <key>TWAP_LOCK_MAX_ORACLE_AGE</key>
        <string>2</string>
        <key>TWAP_LOCK_MAX_BOOK_AGE</key>
        <string>3</string>
        <key>CRYPTO_MIN_EDGE</key>
        <string>0.012</string>
        <key>CRYPTO_MIN_SECONDS_TO_EXPIRY</key>
        <string>2</string>
        <key>CRYPTO_SIGNAL_TTL_SECONDS</key>
        <string>6</string>
        <key>CRYPTO_MAX_SLIP</key>
        <string>0.01</string>
        <!-- sizing: the built-in half-Kelly sizer puts ~27% of cash on a 99.5%/0.975 trade
             (about $10 at $38, growing with the bankroll); MAX_CRYPTO_STAKE is only the ceiling -->
        <key>MIN_CRYPTO_STAKE</key>
        <string>2</string>
        <key>MAX_CRYPTO_STAKE</key>
        <string>20</string>
        <!-- 2026-09-12 review: size for a loss rate near the confidence bound, not the 0.995 clamp;
             all lock dollars across the seven coins count as one bet (LOCK_MAX_EXPOSURE_FRAC) -->
        <key>CRYPTO_KELLY_MULT</key>
        <string>0.35</string>
        <key>LOCK_MAX_EXPOSURE_FRAC</key>
        <string>0.30</string>
        <key>LOCK_REST_MAX_USD</key>
        <string>5</string>
        <key>MAX_CRYPTO_POSITIONS</key>
        <string>3</string>
        <key>MAX_POSITIONS</key>
        <string>3</string>
        <!-- risk: no hard floor (user's instruction); only the 3-loss streak halt stays -->
        <key>MAX_CONSECUTIVE_CRYPTO_LOSSES</key>
        <string>3</string>
        <key>MAX_SESSION_DRAWDOWN</key>
        <string>1000</string>
        <key>HALT_BANKROLL</key>
        <string>0</string>
        <key>CAMPAIGN_TARGET_USD</key>
        <string>0</string>
        <key>MAX_DRAWDOWN</key>
        <string>1.0</string>
        <key>PROFIT_LOCK_FRACTION</key>
        <string>0</string>
        <key>MAX_DAILY_LOSS</key>
        <string>1000</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/Users/roomyhome/Tradeinc/data/live.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/roomyhome/Tradeinc/data/live.err.log</string>
</dict>
</plist>
