<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Polymarket US daily-high-temperature ladders, PAPER trader (public data only, no keys). See docs/US_RESEARCH.md. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.tradeinc.ustemp</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/roomyhome/Tradeinc/.venv/bin/python</string>
        <string>-X</string><string>utf8</string><string>-u</string>
        <string>-m</string><string>scout.us_temp_paper</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/roomyhome/Tradeinc</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key><string>/Users/roomyhome</string>
        <key>PATH</key><string>/Users/roomyhome/Tradeinc/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUTF8</key><string>1</string>
        <key>USTEMP_POLL_S</key><string>60</string>
        <key>USTEMP_STAKE_USD</key><string>25</string>
        <key>USTEMP_CASH</key><string>500</string>
        <key>USTEMP_MAX_ASK_R0</key><string>0.97</string>
        <key>USTEMP_R2_MARGIN</key><string>3</string>
        <key>USTEMP_R2_MIN_BID</key><string>0.15</string>
        <key>USTEMP_CONFIRM_POLLS</key><string>2</string>
        <key>USTEMP_R1</key><string>0</string>
        <!-- 2026-09-23: NWS intraday climate report (~16:25 EDT Miami, ~16:35 NYC/Chicago local) as trusted max, and as an
             early R1x trigger once the METAR peak has passed (fall >= 2F, >= 60 min since max, >= 15:00 local):
             backtest 467 city-days, report max == final high 98/97/93% under that gate, 40/44 simulated trades. -->
        <key>USTEMP_CLI_OBS</key><string>1</string>
        <key>USTEMP_CLI_TRIGGER</key><string>1</string>
        <key>USTEMP_CLI_FALL</key><string>2</string>
        <key>USTEMP_CLI_MIN_SINCE</key><string>60</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>30</integer>
    <key>StandardOutPath</key><string>/Users/roomyhome/Tradeinc/data/us_temp.log</string>
    <key>StandardErrorPath</key><string>/Users/roomyhome/Tradeinc/data/us_temp.err.log</string>
</dict>
</plist>
