<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- NOT INSTALLED. Kalshi lab forward PAPER logger (public data only, no keys, never orders): Truth Social DAILY count D1
     (data/kalshi_lab/strategies/r7_truth_social_daily_forward_shadow/preregistration.json).
     Every 15 min at :00/:15/:30/:45: a pass inside 10:00-23:59 ET (<= 10 Kalshi calls), an hourly settlement attempt in
     the first quarter-hour (shares the 10-call cap), the summary when something settled; otherwise a no-op.
     Install (account holder): cp this file ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.tradeinc.klab.truthsocial.daily.plist -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.tradeinc.klab.truthsocial.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string><string>-c</string>
        <string>cd /Users/roomyhome/Tradeinc &amp;&amp; .venv/bin/python -X utf8 -u -m lab.kalshi.strategies.r7_truth_social_daily_forward_shadow_logger auto</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/roomyhome/Tradeinc</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
    </array>
    <key>StandardOutPath</key><string>/Users/roomyhome/Tradeinc/data/kalshi_lab/logs/com.tradeinc.klab.truthsocial.daily.log</string>
    <key>StandardErrorPath</key><string>/Users/roomyhome/Tradeinc/data/kalshi_lab/logs/com.tradeinc.klab.truthsocial.daily.err.log</string>
</dict>
</plist>
