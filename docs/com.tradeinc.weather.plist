<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weather observed-max lock (scout/weather_lock.py). PAPER: WEATHER_LIVE=0 records would-be fills only.
     To trade real money set WEATHER_LIVE to 1 and restart the job (that is the operator's action). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradeinc.weather</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/roomyhome/Tradeinc/.venv/bin/python</string>
        <string>-X</string>
        <string>utf8</string>
        <string>-u</string>
        <string>-m</string>
        <string>scout.weather_lock</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/roomyhome/Tradeinc</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/roomyhome</string>
        <key>PATH</key>
        <string>/Users/roomyhome/Tradeinc/.venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUTF8</key>
        <string>1</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>WEATHER_LIVE</key>
        <string>0</string>
        <key>WEATHER_LOCK_HOUR</key>
        <string>17</string>
        <key>WEATHER_MIN_GAP_MIN</key>
        <string>60</string>
        <key>WEATHER_MAX_ASK</key>
        <string>0.90</string>
        <key>WEATHER_MIN_ASK</key>
        <string>0.05</string>
        <key>WEATHER_STAKE_USD</key>
        <string>10</string>
        <key>WEATHER_MAX_OPEN</key>
        <string>5</string>
        <key>WEATHER_POLL_S</key>
        <string>300</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/Users/roomyhome/Tradeinc/data/weather.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/roomyhome/Tradeinc/data/weather.err.log</string>
</dict>
</plist>
